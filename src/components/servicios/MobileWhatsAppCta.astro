---
import { whatsappLinks } from './data'
import WhatsAppIcon from './WhatsAppIcon.astro'
---

<aside
  id='mobile-whatsapp-cta'
  aria-label='Contacto rápido por WhatsApp'
  class='pointer-events-none fixed inset-x-3 bottom-3 z-40 translate-y-5 opacity-0 transition duration-500 ease-out md:hidden'
>
  <a
    href={whatsappLinks.general}
    target='_blank'
    rel='noreferrer'
    data-whatsapp-location='mobile_sticky'
    class='flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-[#101018]/95 px-4 py-3 shadow-2xl shadow-black/50 backdrop-blur-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-400'
  >
    <span>
      <span class='block text-xs text-zinc-400'>¿Tienes un proyecto?</span>
      <span class='block text-sm font-bold text-white'>Hablemos por WhatsApp</span>
    </span>
    <span class='flex size-10 items-center justify-center rounded-full bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white'>
      <WhatsAppIcon class='size-5' />
    </span>
  </a>
</aside>
