---
const steps = [
  {
    number: '01',
    title: 'Diagnóstico',
    description: 'Reviso la situación actual de tu negocio: cómo llegan tus clientes hoy y qué plataforma tiene sentido.',
  },
  {
    number: '02',
    title: 'Diseño y desarrollo',
    description: 'Construyo tu sitio o tienda con foco en velocidad, catálogo claro y checkout sin fricción.',
  },
  {
    number: '03',
    title: 'Lanzamiento',
    description: 'Pruebas, ajustes finales y salida a producción, con seguimiento desde el día uno.',
  },
  {
    number: '04',
    title: 'Optimización',
    description: 'Ajustes continuos según datos reales de tráfico — puede incluir mejoras a la pauta.',
  },
]
---

<section id='proceso' class='relative scroll-mt-24 border-y border-white/5 bg-white/[0.02] py-20 md:py-28'>
  <div class='mx-auto max-w-6xl px-5'>
    <div class='mx-auto max-w-2xl text-center'>
      <span data-reveal class='text-xs font-semibold tracking-[0.2em] text-violet-400 uppercase'>Cómo trabajo</span>
      <h2
        data-reveal
        style='--reveal-delay: 100ms'
        class='mt-3 text-3xl font-bold tracking-tight text-white text-balance md:text-4xl'
      >
        Un proceso claro, sin sorpresas
      </h2>
      <p data-reveal style='--reveal-delay: 200ms' class='mt-4 text-lg leading-relaxed text-zinc-400'>
        Sabrás en qué etapa está tu proyecto en todo momento, desde el primer mensaje hasta después del lanzamiento.
      </p>
    </div>

    <ol class='relative mt-16 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-6'>
      <!-- Línea conectora (desktop) -->
      <div
        aria-hidden='true'
        class='absolute top-6 right-[12%] left-[12%] hidden h-px bg-gradient-to-r from-violet-500/10 via-violet-400/40 to-fuchsia-500/10 lg:block'
      >
      </div>

      {
        steps.map((step, index) => (
          <li data-reveal style={`--reveal-delay: ${index * 120}ms`} class='relative flex flex-col items-center text-center'>
            <span class='relative z-10 flex size-12 items-center justify-center rounded-full border border-violet-400/40 bg-[#0b0b13] text-sm font-bold text-violet-300 shadow-lg shadow-violet-950/50'>
              {step.number}
            </span>
            <h3 class='mt-5 text-lg font-bold text-white'>{step.title}</h3>
            <p class='mt-2 leading-relaxed text-zinc-400'>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
