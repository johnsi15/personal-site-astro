---
import Layout from '../../layouts/generic.astro'
import Nav from '../../components/servicios/Nav.astro'
import Hero from '../../components/servicios/Hero.astro'
import TrustStrip from '../../components/servicios/TrustStrip.astro'
import Features from '../../components/servicios/Features.astro'
import CaseStudy from '../../components/servicios/CaseStudy.astro'
import AboutJohn from '../../components/servicios/AboutJohn.astro'
import Process from '../../components/servicios/Process.astro'
import Packages from '../../components/servicios/Packages.astro'
import Faq from '../../components/servicios/Faq.astro'
import FinalCta from '../../components/servicios/FinalCta.astro'
import Footer from '../../components/servicios/Footer.astro'
import MobileWhatsAppCta from '../../components/servicios/MobileWhatsAppCta.astro'

import '@fontsource/source-sans-pro/600.css'

const serviceStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://johnserrano.co/servicios#professional-service',
  name: 'John Serrano - Desarrollo web y tiendas online',
  url: 'https://johnserrano.co/servicios',
  image: 'https://johnserrano.co/servicios/og-servicios.jpg',
  description:
    'Diseño y desarrollo de sitios web y tiendas online para negocios en Latinoamérica, con catálogo, pagos, envíos y campañas digitales.',
  telephone: '+57 310 602 9831',
  founder: {
    '@type': 'Person',
    name: 'John Serrano',
    jobTitle: 'Ingeniero de software',
    url: 'https://johnserrano.co',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cúcuta',
    addressRegion: 'Norte de Santander',
    addressCountry: 'CO',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Latinoamérica',
  },
  sameAs: [
    'https://www.linkedin.com/in/johnserranodev',
    'https://github.com/johnsi15',
    'https://www.facebook.com/johnserranodev',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de desarrollo web',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Sitio web',
          description: 'Sitio web para presentar servicios, recibir contactos y conectar con WhatsApp.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Tienda online',
          description: 'Tienda con catálogo, pasarela de pagos, envíos y experiencia optimizada para celular.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Tienda online y pauta',
          description: 'Tienda online con montaje y ajuste de campañas en Meta y Google.',
        },
      },
    ],
  },
}
---

<Layout
  title='Sitios web y tiendas online para negocios | John Serrano'
  description='Diseño y desarrollo de sitios web y tiendas online que convierten visitas en clientes. Caso real: una tienda que pasó de $0 a $20–25M COP/mes en ventas online. Cotiza por WhatsApp.'
  image='/servicios/og-servicios.jpg'
  structuredData={serviceStructuredData}
>
  <div id='servicios-page'>
    <Nav />
    <main>
      <Hero />
      <TrustStrip />
      <Features />
      <CaseStudy />
      <AboutJohn />
      <Process />
      <Packages />
      <Faq />
      <FinalCta />
    </main>
    <Footer />
    <MobileWhatsAppCta />
  </div>

  <noscript>
    <style>
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</Layout>

<script>
  import { sendEventData } from '../../helpers/sendEventData'

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // --- Nav: transparente -> sólido con blur al hacer scroll ---
  const nav = document.getElementById('site-nav')
  const mobileStickyCta = document.getElementById('mobile-whatsapp-cta')
  const hero = document.getElementById('inicio')
  const contact = document.getElementById('contacto')

  const updatePageUi = () => {
    nav?.classList.toggle('scrolled', window.scrollY > 16)

    if (mobileStickyCta && hero && contact) {
      const afterHero = hero.getBoundingClientRect().bottom < 80
      const beforeFinalCta = contact.getBoundingClientRect().top > window.innerHeight * 0.8
      mobileStickyCta.classList.toggle('is-visible', afterHero && beforeFinalCta)
    }
  }

  updatePageUi()
  window.addEventListener('scroll', updatePageUi, { passive: true })
  window.addEventListener('resize', updatePageUi)

  // --- Menú móvil ---
  const menuToggle = document.getElementById('menu-toggle')
  const closeMobileMenu = (restoreFocus = false) => {
    nav?.classList.remove('menu-open')
    menuToggle?.classList.remove('open')
    menuToggle?.setAttribute('aria-expanded', 'false')
    menuToggle?.setAttribute('aria-label', 'Abrir menú de navegación')
    document.body.style.overflow = ''
    if (restoreFocus) menuToggle?.focus()
  }

  menuToggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('menu-open') ?? false
    menuToggle.classList.toggle('open', isOpen)
    menuToggle.setAttribute('aria-expanded', String(isOpen))
    menuToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación')
    document.body.style.overflow = isOpen ? 'hidden' : ''
  })

  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => closeMobileMenu())
  })

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && nav?.classList.contains('menu-open')) closeMobileMenu(true)
  })

  document.addEventListener('click', event => {
    if (nav?.classList.contains('menu-open') && event.target instanceof Node && !nav.contains(event.target)) {
      closeMobileMenu(true)
    }
  })

  // --- Estado activo de la navegación ---
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
  const sections = ['inicio', 'servicios', 'casos', 'proceso', 'contacto']
    .map(id => document.getElementById(id))
    .filter((section): section is HTMLElement => Boolean(section))

  const sectionObserver = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return
        navLinks.forEach(link => {
          const isCurrent = link.hash === `#${entry.target.id}`
          link.classList.toggle('is-current', isCurrent)
          if (isCurrent) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        })
      })
    },
    { rootMargin: '-35% 0px -55% 0px' }
  )
  sections.forEach(section => sectionObserver.observe(section))

  // --- Medición de clics hacia WhatsApp ---
  const trackingWindow = window as typeof window & { dataLayer?: Array<Record<string, unknown>> }
  const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']
  const queryParams = new URLSearchParams(window.location.search)

  attributionKeys.forEach(key => {
    const value = queryParams.get(key)
    if (value) sessionStorage.setItem(key, value)
  })

  document.querySelectorAll<HTMLElement>('[data-whatsapp-location]').forEach(link => {
    link.addEventListener('click', () => {
      const ctaLocation = link.dataset.whatsappLocation || 'unknown'
      const serviceName = link.dataset.whatsappService || 'general'
      const eventId = `whatsapp_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`
      const attribution = Object.fromEntries(
        attributionKeys.flatMap(key => {
          const value = sessionStorage.getItem(key)
          return value ? [[key, value]] : []
        })
      )

      trackingWindow.dataLayer = trackingWindow.dataLayer || []
      trackingWindow.dataLayer.push({
        event: 'whatsapp_click',
        ga4_event_name: 'generate_lead',
        contact_method: 'whatsapp',
        cta_location: ctaLocation,
        service_name: serviceName,
        page_path: window.location.pathname,
        event_id: eventId,
        ...attribution,
      })

      sendEventData({
        event_name: 'Contact',
        event_id: eventId,
        title: `WhatsApp · ${serviceName} · ${ctaLocation}`,
      })
    })
  })

  // --- Reveal al hacer scroll (fade + slide-up) ---
  const revealElements = document.querySelectorAll<HTMLElement>('[data-reveal]')

  if (prefersReducedMotion) {
    revealElements.forEach(el => el.classList.add('is-visible'))
  } else {
    const revealObserver = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            revealObserver.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15, rootMargin: '0px 0px -48px 0px' }
    )
    revealElements.forEach(el => revealObserver.observe(el))
  }

  // --- Contadores animados (count-up) ---
  const counters = document.querySelectorAll<HTMLElement>('[data-count-to]')
  const localeFormatter = new Intl.NumberFormat('es-CO')

  const formatValue = (el: HTMLElement, value: number) =>
    el.hasAttribute('data-count-locale') ? localeFormatter.format(value) : String(value)

  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.countTo ?? 0)
    const duration = 1800
    const start = performance.now()

    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1)
      const eased = 1 - Math.pow(1 - progress, 4)
      el.textContent = formatValue(el, Math.round(target * eased))
      if (progress < 1) requestAnimationFrame(step)
    }
    requestAnimationFrame(step)
  }

  if (prefersReducedMotion) {
    counters.forEach(el => {
      el.textContent = formatValue(el, Number(el.dataset.countTo ?? 0))
    })
  } else {
    const countObserver = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement)
            countObserver.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.4 }
    )
    counters.forEach(el => countObserver.observe(el))
  }
</script>

<style is:global>
  #servicios-page {
    font-family: 'Source Sans Pro', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    background-color: #07070c;
    background-image: linear-gradient(to bottom, #07070c, #0a0a14 50%, #07070c);
    color: #f4f4f5;
    -webkit-font-smoothing: antialiased;
  }

  #servicios-page ::selection {
    background-color: rgb(139 92 246 / 0.45);
    color: #ffffff;
  }

  /* --- Reveal on scroll --- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Nav: estado al hacer scroll / menú abierto --- */
  #site-nav {
    border-bottom: 1px solid transparent;
  }

  #site-nav.scrolled,
  #site-nav.menu-open {
    background-color: rgb(7 7 12 / 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: rgb(255 255 255 / 0.08);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }

  #site-nav [data-nav-link].is-current {
    background-color: rgb(255 255 255 / 0.07);
    color: #ffffff;
  }

  /* --- Menú móvil --- */
  #mobile-menu {
    display: none;
  }

  #site-nav.menu-open #mobile-menu {
    display: block;
    animation: menu-in 0.25s ease-out;
  }

  #mobile-whatsapp-cta {
    bottom: max(0.75rem, env(safe-area-inset-bottom));
  }

  #mobile-whatsapp-cta.is-visible {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- Hamburguesa --- */
  .menu-bar {
    position: absolute;
    top: 50%;
    left: 10px;
    right: 10px;
    height: 2px;
    margin-top: -1px;
    border-radius: 2px;
    background-color: #ffffff;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .menu-bar-top {
    transform: translateY(-4px);
  }

  .menu-bar-bottom {
    transform: translateY(4px);
  }

  #menu-toggle.open .menu-bar-top {
    transform: rotate(45deg);
  }

  #menu-toggle.open .menu-bar-bottom {
    transform: rotate(-45deg);
  }

  /* --- Gráfica de crecimiento (draw-in) --- */
  .hero-chart .hero-line {
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
    animation: hero-line-draw 2.2s cubic-bezier(0.22, 0.61, 0.36, 1) 0.4s forwards;
  }

  .hero-chart .hero-area-clip__rect {
    animation: hero-area-grow 2.2s cubic-bezier(0.22, 0.61, 0.36, 1) 0.4s forwards;
  }

  .hero-chart__point {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transform: scale(0);
    opacity: 0;
    animation: hero-point-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 2.5s forwards;
  }

  @keyframes hero-line-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-area-grow {
    to {
      width: 400px;
    }
  }

  @keyframes hero-point-pop {
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* --- Tarjetas flotantes del hero --- */
  .animate-float-slow {
    animation: floaty 6s ease-in-out infinite;
  }

  .animate-float-fast {
    animation: floaty 4.5s ease-in-out infinite;
  }

  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* --- Accesibilidad: movimiento reducido --- */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .animate-float-slow,
    .animate-float-fast {
      animation: none !important;
    }

    .hero-chart .hero-line,
    .hero-chart .hero-area-clip__rect,
    .hero-chart__point {
      animation: none !important;
    }

    .hero-chart .hero-line {
      stroke-dashoffset: 0;
    }

    .hero-chart .hero-area-clip__rect {
      width: 400px;
    }

    .hero-chart__point {
      opacity: 1;
      transform: none;
    }

    .animate-ping {
      display: none;
    }
  }
</style>
